# Reading example: standard EBS CSI driver, not EKS Auto Mode.
# A consumer Pod must reference this PVC before WaitForFirstConsumer progresses.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: study-ebs
provisioner: ebs.csi.aws.com
parameters:
  type: gp3
  encrypted: "true"
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
allowVolumeExpansion: true
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: study-data
  namespace: study
spec:
  storageClassName: study-ebs
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
