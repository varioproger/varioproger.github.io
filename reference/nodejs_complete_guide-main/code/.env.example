# ---------------------------------------------------------------------------
# 『Node.js Complete Guide』 예제 저장소 환경 변수 견본
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# Node 20+ 는 `node --env-file=.env server.js` 로 별도 라이브러리 없이 읽는다.
# ---------------------------------------------------------------------------

# --- 공통 ---
NODE_ENV=development                  # development | test | production. 설정 로딩 지점에서만 분기한다
LOG_LEVEL=debug                       # trace|debug|info|warn|error|fatal. 프로덕션 기본값은 info
LOG_PRETTY=true                       # true면 pino-pretty로 사람이 읽는 출력. 프로덕션은 false(순수 JSON)
SERVICE_VERSION=1.0.0                 # 로그·메트릭·트레이스의 공통 리소스 속성으로 붙는다
SHUTDOWN_TIMEOUT_MS=10000             # 우아한 종료 유예 시간. 이 안에 못 끝내면 강제 종료한다

# --- recipe-api (프로듀서, 내부 전용) ---
RECIPE_API_HOST=127.0.0.1             # 컨테이너 안에서는 0.0.0.0 으로 바꿔야 외부에서 붙는다
RECIPE_API_PORT=4000                  # recipe-api 가 listen 하는 포트
RECIPE_API_LATENCY_MS=0               # 인위적 지연 주입(ms). 타임아웃·서킷 브레이커 실습용
RECIPE_API_FAIL_RATE=0                # 0~1. 무작위 500 응답 비율. 재시도 실습용

# --- web-api (컨슈머, 외부 노출) ---
WEB_API_HOST=127.0.0.1                # 컨테이너 안에서는 0.0.0.0
WEB_API_PORT=3000                     # web-api 가 listen 하는 포트
RECIPE_API_URL=http://127.0.0.1:4000  # web-api 가 호출할 recipe-api 베이스 URL

# --- 하류 호출 정책 (packages/shared/src/http-client.js) ---
HTTP_TIMEOUT_MS=1000                  # 개별 시도 하나의 타임아웃. 재시도 총합이 아니다
HTTP_RETRIES=2                        # 최초 시도 이후 추가 재시도 횟수. 재시도는 한 계층에서만 켠다
HTTP_RETRY_BASE_MS=100                # 지수 백오프 기준 간격. 실제 대기는 [0, base*2^n) 풀 지터
HTTP_RETRY_MAX_MS=2000                # 백오프 상한. 상한이 없으면 대기가 폭주한다
HTTP_DEADLINE_MS=3000                 # 요청 진입점에서 잡는 전체 예산. 재시도 총합의 상한
BREAKER_FAILURE_THRESHOLD=5           # 연속 실패가 이 수를 넘으면 회로를 연다(open)
BREAKER_RESET_TIMEOUT_MS=10000        # open 상태를 유지할 시간. 지나면 half-open 으로 탐색한다
BREAKER_HALF_OPEN_MAX=1               # half-open 에서 통과시킬 탐색 요청 수
BREAKER_SUCCESS_THRESHOLD=2           # half-open 에서 이만큼 연속 성공하면 closed 로 복귀한다

# --- 관측성: 메트릭 (packages/shared/src/metrics.js) ---
METRICS_ENABLED=true                  # false 면 /metrics 를 노출하지 않는다
METRICS_PREFIX=                       # 지표 이름 접두사. 비워 두면 접두사 없음
EVENT_LOOP_MONITOR_RESOLUTION_MS=10   # monitorEventLoopDelay 샘플링 해상도

# --- 관측성: 분산 추적 (packages/shared/src/tracing.js) ---
TRACING_ENABLED=false                                    # true 로 바꾸면 OpenTelemetry SDK 를 켠다
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318        # OTLP/HTTP 콜렉터 주소. /v1/traces 는 코드가 붙인다
OTEL_TRACE_SAMPLE_RATIO=1.0                              # 0~1. 프로덕션은 0.01~0.1 이 흔하다
OTEL_LOG_LEVEL=error                                     # SDK 자체 진단 로그 레벨

# --- 데이터 계층 (19장 이후) ---
DATABASE_URL=postgres://ncg:ncg@127.0.0.1:5432/ncg       # PostgreSQL 접속 문자열
PG_POOL_MAX=10                                           # 커넥션 풀 최대 크기. 인스턴스 수 × 이 값 ≤ DB 상한
REDIS_URL=redis://127.0.0.1:6379                         # 세션·캐시·분산 락에 쓴다

# --- 인증 (17장 이후) ---
SESSION_SECRET=change-me-to-a-32-char-random-string      # 32자 이상. 실제 값은 시크릿 매니저에서 주입한다
JWT_SECRET=change-me-to-a-32-char-random-string          # 32자 이상. 환경마다 다른 값을 쓴다
